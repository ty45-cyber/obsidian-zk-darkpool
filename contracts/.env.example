# Midnight Preprod Deployment Configuration (rwa_darkpool.compact)
# Leave WALLET_SEED empty on first run to generate a fresh 64-byte hex seed and save it to .env
WALLET_SEED=

# Network selection: preprod (default) | preview | undeployed
MIDNIGHT_NETWORK=preprod

# Midnight Preprod Endpoints (defaults used if omitted)
MIDNIGHT_INDEXER_URL=https://indexer.preprod.midnight.network/api/v3/graphql
MIDNIGHT_INDEXER_WS_URL=wss://indexer.preprod.midnight.network/api/v3/graphql/ws
MIDNIGHT_NODE_URL=https://rpc.preprod.midnight.network
MIDNIGHT_PROOF_SERVER_URL=http://127.0.0.1:6300

# Optional constructor preimages (32-byte hex or UTF-8 string; deterministic defaults used if omitted)
ENCLAVE_PCR0_PREIMAGE=obsidian-aws-nitro-enclave-pcr0-v3
ORACLE_SECRET_PREIMAGE=obsidian-nav-oracle-secret-v3
MAKER_KYC_SECRET_PREIMAGE=obsidian-inst-maker-kyc-v3
TAKER_KYC_SECRET_PREIMAGE=obsidian-inst-taker-kyc-v3
TRANSFER_AGENT_VIEWING_PREIMAGE=obsidian-securitize-ta-view-key-v3
